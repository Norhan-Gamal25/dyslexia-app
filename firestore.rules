rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Practice paragraphs + word lists stored in the seed document.
    // Readable by any signed-in user; only the console/seed can write.
    match /practicepara/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Every user owns their own profile document. Reads are open to any
    // signed-in user so a parent can look a child up by link code. Writes
    // are limited to the document owner, plus one exception: while linking,
    // a parent is allowed to append their own id to a child's parentIds.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
          request.auth.uid == userId ||
          (request.resource.data.parentIds is list &&
           request.auth.uid in request.resource.data.parentIds));
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Sessions are written by the child who owns them and read by any
      // signed-in user (so a linked parent sees the progress dashboard).
      match /sessions/{sessionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Custom words collected by scanning flashcards/books. Written by the
      // owning child; read by any signed-in user (parents + the child).
      match /customWords/{wordId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Gamification: points, streaks, daily goals and badges for the child.
      // Written by the owning child; read by any signed-in user (so a linked
      // parent can browse the Rewards screen).
      match /profile/{field} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}